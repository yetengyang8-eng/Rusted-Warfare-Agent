diff --git a/tools/verify_public_relay.py b/tools/verify_public_relay.py
new file mode 100644
index 0000000..9adf113
--- /dev/null
+++ b/tools/verify_public_relay.py
@@ -0,0 +1,158 @@
+#!/usr/bin/env python3
+"""Verify the public relay's shipped bytes and derived grids, without a game install.
+
+This does not reproduce private source verification, full regression or native matches.
+It never rebuilds the knowledge packet or modifies the runtime overlay.
+"""
+import argparse
+from collections import Counter
+from datetime import datetime, timezone
+import hashlib
+import json
+from pathlib import Path
+import sys
+import zipfile
+
+
+AGENT_SHA = '5741e241ce8ec1b921f36ed3274087609d0430f9281c44f6f62c096de84c5f54'
+CONTENT_DIGEST = '82438a7b373111dca88b38e7a1c2779527a9cef136cdb9a1297bdf4c511273a7'
+GAME_SHA = '8a550a37e2d8a5430866090d4e7d5892f9010b47f52a5a09350fc66c620deec9'
+CATALOG_SHA = '263cdaaa3e923e8307c37f059e50bee529b8ecd7c3e215937ce2adf615a0e236'
+TERRAIN_SHA = 'ec38ef06c7ba378db7d4eb420a087f5205183a0bf02df400085db4d80196beb9'
+
+
+def sha(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def read_json(path):
+    return json.loads(path.read_text(encoding='utf-8-sig'))
+
+
+def verify(root):
+    checks, differences = [], []
+
+    def check(name, passed):
+        checks.append({'name': name, 'passed': bool(passed)})
+
+    relay = root / 'astra-relay'
+    manifest = read_json(relay / 'P1F_ENVIRONMENT_MANIFEST.json')
+    check('manifest frozen identities', manifest['gameLibSha256'] == GAME_SHA
+          and manifest['agentJarSha256'] == AGENT_SHA)
+    with zipfile.ZipFile(relay / 'P1F-runtime-overlay-public.zip') as archive:
+        names = [item['name'] for item in manifest['included']]
+        check('overlay ZIP inventory', sorted(archive.namelist()) == sorted(names))
+        for item in manifest['included']:
+            name = item['name']
+            raw = archive.read(name)
+            checkout = (relay / 'runtime-overlay' / name).read_bytes()
+            check('ZIP manifest bytes: ' + name,
+                  len(raw) == item['size'] and sha(raw) == item['sha256'])
+            text = Path(name).suffix.lower() in ('.bat', '.md') or name == 'VERSION'
+            normalized = text and raw.replace(b'\r\n', b'\n') == checkout.replace(b'\r\n', b'\n')
+            check('checkout content: ' + name, checkout == raw or normalized)
+            if checkout != raw and normalized:
+                differences.append(name)
+
+    jar = relay / 'runtime-overlay/rw-agent-bootstrap.jar'
+    check('candidate whole-file SHA256', sha(jar.read_bytes()) == AGENT_SHA)
+    with zipfile.ZipFile(jar) as archive:
+        entries = {name: sha(archive.read(name)) for name in archive.namelist()
+                   if name != 'META-INF/MANIFEST.MF'}
+        digest = sha('\n'.join('%s %s' % (name, entries[name])
+                              for name in sorted(entries)).encode('utf-8'))
+        check('candidate contentDigest', digest == CONTENT_DIGEST)
+        catalog_bytes = archive.read('knowledge/UNIT_CATALOG_CANDIDATES.json')
+    check('catalog in JAR, resources and packet', sha(catalog_bytes) == CATALOG_SHA
+          and catalog_bytes == (root / 'agent/resources/knowledge/UNIT_CATALOG_CANDIDATES.json').read_bytes()
+          and catalog_bytes == (root / 'knowledge/UNIT_CATALOG_CANDIDATES.json').read_bytes())
+
+    packet = root / 'knowledge'
+    omitted, present = [], 0
+    for item in read_json(packet / 'PACKET_MANIFEST.json')['files']:
+        path = packet / item['path']
+        if not path.is_file():
+            omitted.append(item['path'])
+            continue
+        present += 1
+        raw = path.read_bytes()
+        check('packet bytes: ' + item['path'],
+              len(raw) == item['bytes'] and sha(raw) == item['sha256'])
+    # The publishing notes exclude copied third-party/private evidence.
+    check('packet omissions confined to evidence',
+          all(path.startswith('evidence/') for path in omitted))
+
+    catalog = json.loads(catalog_bytes)
+    check('catalog frozen game', catalog['gameJarSha256'] == GAME_SHA)
+    check('catalog coverage', len(catalog['units']) == 10 and len(catalog['aliasMap']) == 14)
+    ids = {unit['id'] for unit in catalog['units']}
+    check('catalog aliases resolve', set(catalog['aliasMap'].values()) <= ids)
+    fields = [field for unit in catalog['units'] for field in unit['fields'].values()]
+    check('field provenance metadata', all({'value', 'status', 'source'} <= field.keys()
+                                         and field['source'] for field in fields))
+
+    terrain_path = packet / 'TERRAIN_MAP_CANDIDATES.json'
+    terrain = read_json(terrain_path)
+    check('terrain packet identity', sha(terrain_path.read_bytes()) == TERRAIN_SHA
+          and terrain['gameJarSha256'] == GAME_SHA)
+    check('nine derived maps', len(terrain['maps']) == 9)
+    grid_count = 0
+    for item in terrain['maps']:
+        grid = read_json(packet / item['terrainGridCandidate'])
+        check('map/grid identity: ' + item['id'],
+              grid['mapSha256'] == item['sha256']
+              and (grid['width'], grid['height']) == (item['width'], item['height'])
+              and grid['order'] == 'TMX_ROW_MAJOR_Y_TIMES_WIDTH_PLUS_X'
+              and grid['engineIndex'] == 'x*height+y')
+        check('movement coverage: ' + item['id'], set(grid['costRle']) ==
+              {'LAND', 'WATER', 'HOVER', 'OVER_CLIFF', 'OVER_CLIFF_WATER', 'BUILDING', 'AIR', 'NONE'})
+        for movement, runs in grid['costRle'].items():
+            grid_count += 1
+            histogram = Counter()
+            for value, length in runs:
+                if type(value) is not int or type(length) is not int or length <= 0:
+                    raise ValueError('Invalid RLE in ' + item['id'] + '/' + movement)
+                histogram[str(value)] += length
+            check('RLE length/histogram: ' + item['id'] + '/' + movement,
+                  sum(histogram.values()) == grid['width'] * grid['height']
+                  and dict(histogram) == item['terrainCostHistogramCandidate'][movement])
+    check('resource count metadata', sum(item['resourcesItemsLayer'] for item in terrain['maps']) == 98)
+    failures = [item['name'] for item in checks if not item['passed']]
+    return {
+        'schemaVersion': 1,
+        'generatedUtc': datetime.now(timezone.utc).isoformat(),
+        'status': 'FAIL' if failures else 'PASS_PUBLIC_ARTIFACT_CHECKS',
+        'agentJarSha256': sha(jar.read_bytes()),
+        'contentDigest': digest,
+        'checks': len(checks), 'failures': failures,
+        'overlayFiles': len(names), 'checkoutLineEndingDifferences': differences,
+        'packetPresentFiles': present, 'packetOmittedEvidenceFiles': len(omitted),
+        'catalogFields': len(fields), 'derivedMovementGrids': grid_count,
+        'limits': [
+            'Packet source/bytecode evidence was omitted from this public mirror; metadata is not re-verification of those sources.',
+            'RLE checks are internal artifact consistency, not a comparison against native terrain d[].',
+            'No full build, engine harness, native match, desktop validation or performance comparison is performed.',
+            'Historical native raw ZIPs and candidate lineage reports are not present in the public evidence directory.'
+        ]
+    }
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--root', type=Path, default=Path(__file__).resolve().parents[1])
+    parser.add_argument('--output', type=Path, help='Optional JSON report; inputs are never rewritten')
+    args = parser.parse_args()
+    try:
+        report = verify(args.root.resolve())
+    except (OSError, ValueError, KeyError, TypeError, zipfile.BadZipFile) as error:
+        report = {'status': 'FAIL', 'error': str(error)}
+    rendered = json.dumps(report, ensure_ascii=False, indent=2) + '\n'
+    if args.output:
+        args.output.parent.mkdir(parents=True, exist_ok=True)
+        args.output.write_text(rendered, encoding='utf-8')
+    print(rendered, end='')
+    return 0 if report['status'] == 'PASS_PUBLIC_ARTIFACT_CHECKS' else 1
+
+
+if __name__ == '__main__':
+    sys.exit(main())
